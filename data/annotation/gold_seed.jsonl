{"id": "line-0012", "text": "太阳中风,阳浮而阴弱,阳浮者,热自发,阴弱者,汗自出,啬啬恶寒,淅淅恶风,翕翕发热,鼻鸣干呕者,桂枝汤主之。", "entities": [{"id": "e1", "type": "SYNDROME", "text": "中风", "start": 2, "end": 4, "source": "manual"}, {"id": "e2", "type": "SYMPTOM", "text": "恶寒", "start": 30, "end": 32, "source": "manual"}, {"id": "e3", "type": "SYMPTOM", "text": "恶风", "start": 35, "end": 37, "source": "manual"}, {"id": "e4", "type": "SYMPTOM", "text": "发热", "start": 40, "end": 42, "source": "manual"}, {"id": "e5", "type": "SYMPTOM", "text": "鼻鸣", "start": 43, "end": 45, "source": "manual"}, {"id": "e6", "type": "SYMPTOM", "text": "干呕", "start": 45, "end": 47, "source": "manual"}, {"id": "e7", "type": "FORMULA", "text": "桂枝汤", "start": 50, "end": 53, "source": "manual"}], "relations": [{"type": "SYNDROME_TO_FORMULA", "head": "e1", "tail": "e7", "source": "manual"}, {"type": "SYMPTOM_TO_SYNDROME", "head": "e2", "tail": "e1", "source": "manual"}, {"type": "SYMPTOM_TO_SYNDROME", "head": "e3", "tail": "e1", "source": "manual"}, {"type": "SYMPTOM_TO_SYNDROME", "head": "e4", "tail": "e1", "source": "manual"}], "meta": {"line_number": 12, "status": "seed_gold"}}
{"id": "line-0014", "text": "桂枝加葛根汤方 方2 葛根四两 麻黄三两去节 芍药二两 生姜三两切 甘草二两,炙 大枣十二枚,擘 桂枝二两,去皮 右七味,以水一斗,先煮麻黄、葛根,减二升,去上沫,内诸药,煮取三升,去滓。", "entities": [{"id": "e1", "type": "FORMULA", "text": "桂枝加葛根汤", "start": 0, "end": 6, "source": "manual"}, {"id": "e2", "type": "HERB", "text": "葛根", "start": 10, "end": 12, "source": "manual"}, {"id": "e3", "type": "HERB", "text": "麻黄", "start": 16, "end": 18, "source": "manual"}, {"id": "e4", "type": "HERB", "text": "芍药", "start": 24, "end": 26, "source": "manual"}, {"id": "e5", "type": "HERB", "text": "生姜", "start": 30, "end": 32, "source": "manual"}, {"id": "e6", "type": "HERB", "text": "甘草", "start": 37, "end": 39, "source": "manual"}, {"id": "e7", "type": "HERB", "text": "大枣", "start": 45, "end": 47, "source": "manual"}, {"id": "e8", "type": "HERB", "text": "桂枝", "start": 55, "end": 57, "source": "manual"}], "relations": [{"type": "FORMULA_CONTAINS_HERB", "head": "e1", "tail": "e2", "source": "manual"}, {"type": "FORMULA_CONTAINS_HERB", "head": "e1", "tail": "e3", "source": "manual"}, {"type": "FORMULA_CONTAINS_HERB", "head": "e1", "tail": "e4", "source": "manual"}, {"type": "FORMULA_CONTAINS_HERB", "head": "e1", "tail": "e5", "source": "manual"}, {"type": "FORMULA_CONTAINS_HERB", "head": "e1", "tail": "e6", "source": "manual"}, {"type": "FORMULA_CONTAINS_HERB", "head": "e1", "tail": "e7", "source": "manual"}, {"type": "FORMULA_CONTAINS_HERB", "head": "e1", "tail": "e8", "source": "manual"}], "meta": {"line_number": 14, "status": "seed_gold"}}